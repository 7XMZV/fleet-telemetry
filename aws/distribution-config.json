  "Origins": {
    "Quantity": 1,
    "Items": [
      {
        "Id": "blueice-site",
        "DomainName": "your-site-bucket.s3.eu-north-1.amazonaws.com",
        "OriginAccessControlId": "EXXXXXXXXXXXXX",
        "S3OriginConfig": {
          "OriginAccessIdentity": ""
        }
      }
    ]
